# Code Agent Gateway Configuration
# Copy this file to .env and fill in your values.

# Optional unless Kimi token refresh is needed
CAG_CLIENT_ID=

# Optional: override default paths
# CAG_CREDENTIALS_PATH=~/.kimi-code/credentials/kimi-code.json
# CAG_DEVICE_ID_PATH=~/.kimi-code/device_id

# Optional: override endpoints
# CAG_AUTH_ENDPOINT=https://auth.kimi.com/api/oauth/token
# CAG_UPSTREAM_BASE=https://api.kimi.com/coding

# Optional: server settings
# CAG_HOST=127.0.0.1
# CAG_PORT=8765
# CAG_MAX_CONCURRENT=30
# CAG_HTTP_WORKERS=64
# CAG_HTTP_PENDING=128
# CAG_HTTP_BACKLOG=128
# CAG_RPM_LIMIT=0
# CAG_MAX_RETRIES=2
# CAG_CODEX_POOL_SIZE=2
# CAG_CODEX_QUEUE_TIMEOUT=30
# CAG_CODEX_CWD=~
# Optional: proxy only the Codex child process (Kimi remains direct)
# CAG_CODEX_PROXY=http://127.0.0.1:7897
# CAG_UPSTREAM_IDLE_CONNECTIONS=8
# CAG_CIRCUIT_FAILURE_THRESHOLD=5
# CAG_CIRCUIT_COOLDOWN=30

# Optional: timeouts (seconds)
# CAG_UPSTREAM_TIMEOUT=600
# CAG_QUEUE_TIMEOUT=300
# CAG_REFRESH_INTERVAL=300
# CAG_REFRESH_THRESHOLD=300

# Optional: logging
# CAG_LOG_DIR=~/.code-agent-gateway/logs
# CAG_LOG_MAX_BYTES=10485760
# CAG_LOG_BACKUP_COUNT=3
# CAG_LOG_DIR_MAX_BYTES=524288000

# Optional: thresholds
# CAG_SLOW_REQUEST_THRESHOLD=30.0
# CAG_GRACEFUL_SHUTDOWN_WAIT=30

# Optional: debug
# CAG_DEBUG_BODY=false

# Optional: response cache (saves tokens for identical requests)
# CAG_ENABLE_CACHE=1
# CAG_CACHE_TTL=300
# CAG_CACHE_MAX_ENTRIES=100

# Optional: message truncation (reduces input tokens for long conversations)
# CAG_ENABLE_TRUNCATE=1
# CAG_MAX_HISTORY_PAIRS=10
# CAG_MAX_ASSISTANT_CHARS=2000

# Optional: single-flight (merge concurrent identical requests into one upstream call)
# CAG_ENABLE_SINGLE_FLIGHT=1
# CAG_SINGLE_FLIGHT_TIMEOUT=30

# Optional: normalized-equivalence cache (newline/outer-whitespace only)
# CAG_ENABLE_EQUIVALENCE_CACHE=1

# Optional: device info (override to hide real machine name)
# CAG_DEVICE_NAME=CodeAgentGateway
# CAG_DEVICE_MODEL=Desktop
# CAG_DEVICE_PLATFORM=macOS
# CAG_DEVICE_VERSION=2.1.153
# CAG_OS_VERSION=15.0
